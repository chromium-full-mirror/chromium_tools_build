      ]
    },
    "name": "test httparchive.go"
  },
  {
    "cmd": [
      "../scripts/upload_new_binaries.py",
      "--check-only",
      "--verbose"
    ],
    "cwd": "[START_DIR]/webpagereplay/src",
    "env": {
      "GO111MODULE": "on",
      "GOBIN": "[CACHE]/gocache/bin",
      "GOCACHE": "[CACHE]/gocache/cache",
      "GOMODCACHE": "[CACHE]/gocache/modcache",
      "GOPACKAGESDRIVER": "off",
      "GOPATH": null,
      "GOPRIVATE": "*.googlesource.com,*.git.corp.google.com,google.com",
      "GOPROXY": null,
      "GOROOT": "[CACHE]/golang",
      "GOTOOLCHAIN": "local"
    },
    "env_prefixes": {
      "PATH": [
        "[CACHE]/golang/bin"
      ]
    },
    "env_suffixes": {
      "PATH": [
