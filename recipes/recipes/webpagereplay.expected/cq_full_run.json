      "GOPROXY": null,
      "GOROOT": "[CACHE]/golang",
      "GOTOOLCHAIN": "local"
    },
    "env_prefixes": {
      "PATH": [
        "[CACHE]/golang/bin"
      ]
    },
    "env_suffixes": {
      "PATH": [
        "[CACHE]/gocache/bin"
      ]
    },
    "name": "test webpagereplay"
  },
  {
    "cmd": [
      "go",
      "test",
      "wpr.go",
      "wpr_test.go"
    ],
    "cwd": "[START_DIR]/webpagereplay/src",
    "env": {
      "GO111MODULE": "on",
      "GOBIN": "[CACHE]/gocache/bin",
      "GOCACHE": "[CACHE]/gocache/cache",
      "GOMODCACHE": "[CACHE]/gocache/modcache",
      "GOPACKAGESDRIVER": "off",
      "GOPATH": null,
      "GOPRIVATE": "*.googlesource.com,*.git.corp.google.com,google.com",
      "GOPROXY": null,
      "GOROOT": "[CACHE]/golang",
      "GOTOOLCHAIN": "local"
    },
    "env_prefixes": {
      "PATH": [
        "[CACHE]/golang/bin"
      ]
    },
    "env_suffixes": {
      "PATH": [
        "[CACHE]/gocache/bin"
      ]
    },
    "name": "test wpr.go"
  },
  {
    "cmd": [
      "go",
      "test",
      "httparchive.go",
      "httparchive_test.go"
    ],
    "cwd": "[START_DIR]/webpagereplay/src",
    "env": {
      "GO111MODULE": "on",
      "GOBIN": "[CACHE]/gocache/bin",
      "GOCACHE": "[CACHE]/gocache/cache",
      "GOMODCACHE": "[CACHE]/gocache/modcache",
      "GOPACKAGESDRIVER": "off",
      "GOPATH": null,
      "GOPRIVATE": "*.googlesource.com,*.git.corp.google.com,google.com",
      "GOPROXY": null,
      "GOROOT": "[CACHE]/golang",
      "GOTOOLCHAIN": "local"
    },
    "env_prefixes": {
      "PATH": [
