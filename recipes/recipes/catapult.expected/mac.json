[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::bot_update]/resources/bot_update.py",
      "--spec-path",
      "cache_dir = '[CACHE]/git'\nsolutions = [{'deps_file': '.DEPS.git', 'managed': True, 'name': 'catapult', 'url': 'https://chromium.googlesource.com/catapult'}]",
      "--revision_mapping_file",
      "{\"got_revision\": \"catapult\"}",
      "--git-cache-dir",
      "[CACHE]/git",
      "--cleanup-dir",
      "[CLEANUP]/bot_update",
      "--output_json",
      "/path/to/tmp/json",
      "--revision",
      "catapult@HEAD"
    ],
    "env": {
      "CHROME_HEADLESS": "1",
      "DEPOT_TOOLS_COLLECT_METRICS": "0",
      "GIT_BACKENDINFO": "1",
      "GIT_DAPPER_TRACE": "1",
      "GIT_HTTP_LOW_SPEED_LIMIT": "102400",
      "GIT_HTTP_LOW_SPEED_TIME": "1800",
      "GIT_SSH_COMMAND": "ssh -o SendEnv=GIT_DAPPER_TRACE -o SendEnv=GIT_BACKENDINFO",
      "GIT_TRACE2_EVENT": "[CLEANUP]/trace2-event",
      "GIT_TRACE_CURL": "[CLEANUP]/trace-curl",
      "GIT_TRACE_CURL_NO_DATA": "1",
      "GIT_TRACE_PACKET": "[CLEANUP]/trace-packet"
    },
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "bot_update",
    "~followup_annotations": [
      "@@@STEP_TEXT@Some step text@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"did_run\": true,@@@",
      "@@@STEP_LOG_LINE@json.output@  \"fixed_revisions\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"catapult\": \"HEAD\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"manifest\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"catapult\": {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"repository\": \"https://fake.org/catapult.git\",@@@",
      "@@@STEP_LOG_LINE@json.output@      \"revision\": \"c812fca9479aacda33f5f5a74d588acef2b4fb02\"@@@",
      "@@@STEP_LOG_LINE@json.output@    }@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"patch_root\": null,@@@",
      "@@@STEP_LOG_LINE@json.output@  \"properties\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"got_revision\": \"c812fca9479aacda33f5f5a74d588acef2b4fb02\",@@@",
      "@@@STEP_LOG_LINE@json.output@    \"got_revision_cp\": \"refs/heads/main@{#287529}\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"root\": \"catapult\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"source_manifest\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"directories\": {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"catapult\": {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"git_checkout\": {@@@",
      "@@@STEP_LOG_LINE@json.output@          \"repo_url\": \"https://fake.org/catapult.git\",@@@",
      "@@@STEP_LOG_LINE@json.output@          \"revision\": \"c812fca9479aacda33f5f5a74d588acef2b4fb02\"@@@",
      "@@@STEP_LOG_LINE@json.output@        }@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    },@@@",
      "@@@STEP_LOG_LINE@json.output@    \"version\": 0@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"step_text\": \"Some step text\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@",
      "@@@SET_BUILD_PROPERTY@got_revision@\"c812fca9479aacda33f5f5a74d588acef2b4fb02\"@@@",
      "@@@SET_BUILD_PROPERTY@got_revision_cp@\"refs/heads/main@{#287529}\"@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_REPO[depot_tools]/gclient.py",
      "runhooks"
    ],
    "cwd": "[START_DIR]/catapult",
    "env_suffixes": {
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "gclient runhooks"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/google_appengine",
      "-ensure-file",
      "infra/gae_sdk/python/all latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure_installed",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/gae_sdk/python/all\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/packages",
      "-ensure-file",
      "infra/tools/protoc/${platform} protobuf_version:v3.6.1",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure_installed (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-protobuf_version\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/protoc/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[CACHE]/osx_sdk",
      "-ensure-file",
      "infra/tools/mac_toolchain/${platform} git_revision:ed58ac9443fe1754e84d596bdaf9961cbaa6e85b",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure_installed (3)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-git_revision:ed5\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/mac_toolchain/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "sw_vers",
      "-productVersion"
    ],
    "infra_step": true,
    "name": "find macOS version",
    "~followup_annotations": [
      "@@@STEP_TEXT@Running on '14.4'.@@@"
    ]
  },
  {
    "cmd": [
      "[CACHE]/osx_sdk/mac_toolchain",
      "install",
      "-kind",
      "mac",
      "-xcode-version",
      "15e204a",
      "-output-dir",
      "[CACHE]/osx_sdk/XCode.app"
    ],
    "infra_step": true,
    "name": "install xcode"
  },
  {
    "cmd": [
      "sudo",
      "xcode-select",
      "--switch",
      "[CACHE]/osx_sdk/XCode.app"
    ],
    "infra_step": true,
    "name": "select XCode"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "[START_DIR]/catapult/catapult_build/build_steps.py",
      "--api-path-checkout",
      "[START_DIR]/catapult",
      "--app-engine-sdk-pythonpath",
      "%(PYTHONPATH)s:[START_DIR]/google_appengine",
      "--platform",
      "mac",
      "--platform_arch",
      "intel",
      "--output-json",
      "/path/to/tmp/json"
    ],
    "cwd": "[START_DIR]/catapult",
    "env_prefixes": {
      "PATH": [
        "[START_DIR]/packages",
        "[START_DIR]/packages/bin"
      ]
    },
    "name": "gen step(build_steps.py)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@[@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"cmd\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      \"run_py_tests\",@@@",
      "@@@STEP_LOG_LINE@json.output@      \"--no-hooks\"@@@",
      "@@@STEP_LOG_LINE@json.output@    ],@@@",
      "@@@STEP_LOG_LINE@json.output@    \"name\": \"Dashboard Tests\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "run_py_tests",
      "--no-hooks"
    ],
    "env_prefixes": {
      "PATH": [
        "[START_DIR]/packages",
        "[START_DIR]/packages/bin"
      ]
    },
    "name": "Dashboard Tests"
  },
  {
    "cmd": [
      "sudo",
      "xcode-select",
      "--reset"
    ],
    "infra_step": true,
    "name": "reset XCode"
  },
  {
    "name": "$result"
  }
]