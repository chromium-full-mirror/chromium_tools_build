[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CACHE]/builder"
    ],
    "infra_step": true,
    "name": "ensure builder cache dir"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::bot_update]/resources/bot_update.py",
      "--spec-path",
      "cache_dir = '[CACHE]/git'\nsolutions = [{'deps_file': '.DEPS.git', 'managed': True, 'name': 'v8', 'url': 'https://chromium.googlesource.com/v8/v8'}]",
      "--revision_mapping_file",
      "{\"got_revision\": \"v8\"}",
      "--git-cache-dir",
      "[CACHE]/git",
      "--cleanup-dir",
      "[CLEANUP]/bot_update",
      "--output_json",
      "/path/to/tmp/json",
      "--revision",
      "v8@HEAD",
      "--with_branch_heads"
    ],
    "cwd": "[CACHE]/builder",
    "env": {
      "CHROME_HEADLESS": "1",
      "DEPOT_TOOLS_COLLECT_METRICS": "0",
      "GIT_BACKENDINFO": "1",
      "GIT_DAPPER_TRACE": "1",
      "GIT_HTTP_LOW_SPEED_LIMIT": "102400",
      "GIT_HTTP_LOW_SPEED_TIME": "1800",
      "GIT_SSH_COMMAND": "ssh -o SendEnv=GIT_DAPPER_TRACE -o SendEnv=GIT_BACKENDINFO",
      "GIT_TRACE2_EVENT": "[CLEANUP]/trace2-event",
      "GIT_TRACE_CURL": "[CLEANUP]/trace-curl",
      "GIT_TRACE_CURL_NO_DATA": "1",
      "GIT_TRACE_PACKET": "[CLEANUP]/trace-packet"
    },
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "bot_update",
    "~followup_annotations": [
      "@@@STEP_TEXT@Some step text@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"did_run\": true,@@@",
      "@@@STEP_LOG_LINE@json.output@  \"fixed_revisions\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"v8\": \"HEAD\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"manifest\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"v8\": {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"repository\": \"https://fake.org/v8.git\",@@@",
      "@@@STEP_LOG_LINE@json.output@      \"revision\": \"f2cbea7e89a45f46819777bb78a1f5bd0241f64c\"@@@",
      "@@@STEP_LOG_LINE@json.output@    }@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"patch_root\": null,@@@",
      "@@@STEP_LOG_LINE@json.output@  \"properties\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"got_revision\": \"f2cbea7e89a45f46819777bb78a1f5bd0241f64c\",@@@",
      "@@@STEP_LOG_LINE@json.output@    \"got_revision_cp\": \"refs/heads/main@{#50110}\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"root\": \"v8\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"source_manifest\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"directories\": {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"v8\": {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"git_checkout\": {@@@",
      "@@@STEP_LOG_LINE@json.output@          \"repo_url\": \"https://fake.org/v8.git\",@@@",
      "@@@STEP_LOG_LINE@json.output@          \"revision\": \"f2cbea7e89a45f46819777bb78a1f5bd0241f64c\"@@@",
      "@@@STEP_LOG_LINE@json.output@        }@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    },@@@",
      "@@@STEP_LOG_LINE@json.output@    \"version\": 0@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  \"step_text\": \"Some step text\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@",
      "@@@SET_BUILD_PROPERTY@got_revision@\"f2cbea7e89a45f46819777bb78a1f5bd0241f64c\"@@@",
      "@@@SET_BUILD_PROPERTY@got_revision_cp@\"refs/heads/main@{#50110}\"@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "branch",
      "-r",
      "--list",
      "branch-heads/*"
    ],
    "cwd": "[CACHE]/builder/v8",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "last branches",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@stdout@branch-heads/9.9@@@",
      "@@@STEP_LOG_LINE@stdout@branch-heads/10.1@@@",
      "@@@STEP_LOG_LINE@stdout@branch-heads/10.2@@@",
      "@@@STEP_LOG_END@stdout@@@"
    ]
  },
  {
    "cmd": [],
    "name": "Last branch 10.2"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "infra/config"
    ],
    "cwd": "[CACHE]/builder/v8",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "git checkout",
    "~followup_annotations": [
      "@@@STEP_LOG_END@stdout@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "pull"
    ],
    "cwd": "[CACHE]/builder/v8",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "git pull",
    "~followup_annotations": [
      "@@@STEP_LOG_END@stdout@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "show",
      "HEAD:definitions.star"
    ],
    "cwd": "[CACHE]/builder/v8",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "Read branch definitions",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@stdout@versions = {\"beta\": \"10.2\", \"stable\": \"10.1\", \"extended\": \"10.0\"}@@@",
      "@@@STEP_LOG_END@stdout@@@"
    ]
  },
  {
    "cmd": [],
    "name": "No new branch detected"
  },
  {
    "name": "$result"
  }
]